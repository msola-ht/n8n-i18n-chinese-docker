# ===========================================
# 代理配置 - 用于网络代理设置
# ===========================================
# HTTP代理主机地址
PROXY_HTTP_HOST=host.docker.internal
# HTTP代理端口
PROXY_HTTP_PORT=7897
# HTTPS代理主机地址
PROXY_HTTPS_HOST=host.docker.internal
# HTTPS代理端口
PROXY_HTTPS_PORT=7897
# 不使用代理的地址列表
NO_PROXY_LIST=localhost,127.0.0.1,n8n.local,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16,.local

# ===========================================
# n8n 应用配置
# ===========================================
# n8n应用版本号
N8N_VERSION=2.2.5

# ===========================================
# PostgreSQL 数据库配置
# ===========================================
# 数据库管理员用户名 (请修改)
POSTGRES_USER=postgres
# 数据库管理员密码 (请修改)
POSTGRES_PASSWORD=changePassword
# 数据库名称
POSTGRES_DB=n8n

# n8n应用专用数据库用户 (请修改)
POSTGRES_NON_ROOT_USER=postgres
# n8n应用专用数据库密码 (请修改)
POSTGRES_NON_ROOT_PASSWORD=changePassword

# ===========================================
# n8n 安全配置
# ===========================================
# n8n数据加密密钥 (必须修改为随机字符串)
N8N_ENCRYPTION_KEY=your-encryption-key-here-please-change
# n8n任务运行器认证令牌 (请修改为随机字符串)
N8N_RUNNERS_AUTH_TOKEN=encryption-key-here-please-change

# ===========================================
# n8n 服务配置
# ===========================================
# n8n Webhook URL
WEBHOOK_URL=http://localhost:7897
# 是否强制设置文件权限
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
